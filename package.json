{
  "name": "remit",
  "version": "0.0.0",
  "private": true,
  "description": "REMIT — static app plus Playwright e2e/evidence tooling (cloud-capable) and spec-kit workflow.",
  "license": "EPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "npm run build && node run-playwright.mjs",
    "test:e2e:local": "npm run build && playwright test",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sparticuz/chromium": "^149.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.3",
    "@deck.gl/geo-layers": "^9.3.3",
    "@deck.gl/layers": "^9.3.3",
    "@deck.gl/mapbox": "^9.3.3",
    "h3-js": "^4.4.0",
    "maplibre-gl": "^5.24.0"
  }
}
